---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	bodyClass?: string;
}

const {
	title = 'MonkeyType',
	description = 'MonkeyType typing experience con acceso a cuenta y configuración.',
	bodyClass = ''
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
