---
import AuthForm from '../../components/auth/AuthForm.astro';
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout
	title="MonkeyType | Nueva contraseña"
	titleKey="auth.resetConfirm.title"
	description="Set a new password for your account."
	descriptionKey="auth.resetConfirm.descriptionMeta"
	activeHref="/reset-password"
>
	<AuthForm
		mode="reset-confirm"
		title="Choose a new password"
		titleKey="auth.resetConfirm.heading"
		description="Use the link from your email to complete the change."
		descriptionKey="auth.resetConfirm.body"
		submitLabel="Save new password"
		submitLabelKey="auth.resetConfirm.submit"
		note="If the link expired, request a new one from the recovery screen."
		noteKey="auth.resetConfirm.note"
		links={[
			{ href: '/reset-password', label: 'auth.resetConfirm.requestAnother' },
			{ href: '/login', label: 'auth.reset.backToLogin' }
		]}
	/>
</AuthLayout>
