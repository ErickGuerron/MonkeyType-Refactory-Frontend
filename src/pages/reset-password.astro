---
import AuthForm from '../components/auth/AuthForm.astro';
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
	title="MonkeyType | Reset password"
	titleKey="auth.reset.title"
	description="Recover access to your account."
	descriptionKey="auth.reset.descriptionMeta"
	activeHref="/reset-password"
>
	<AuthForm
		mode="reset"
		title="Recover access"
		titleKey="auth.reset.heading"
		description="Enter your email to continue."
		descriptionKey="auth.reset.body"
		submitLabel="Send recovery link"
		submitLabelKey="auth.reset.submit"
		note="We will send you a link to set a new password without exposing whether the email exists or not."
		noteKey="auth.reset.note"
		links={[
			{ href: '/login', label: 'auth.reset.backToLogin' },
			{ href: '/register', label: 'auth.reset.newAccount' }
		]}
	/>
</AuthLayout>
