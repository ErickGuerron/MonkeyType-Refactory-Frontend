---
import AuthForm from '../components/auth/AuthForm.astro';
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
	title="MonkeyType | Reset password"
	description="Recuperá el acceso a tu cuenta."
	activeHref="/reset-password"
>
	<AuthForm
		mode="reset"
		title="Recuperar acceso"
		description="Ingresá tu email para continuar."
		submitLabel="Enviar enlace de recuperación"
		note="Te vamos a enviar un link para definir una nueva contraseña sin exponer si el email existe o no."
		links={[
			{ href: '/login', label: 'Volver a login' },
			{ href: '/register', label: 'Crear una cuenta nueva' }
		]}
	/>
</AuthLayout>
