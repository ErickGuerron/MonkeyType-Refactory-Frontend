---
import AuthForm from '../components/auth/AuthForm.astro';
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
	title="MonkeyType | Register"
	titleKey="auth.register.title"
	description="Create your account in MonkeyType."
	descriptionKey="auth.register.descriptionMeta"
	activeHref="/register"
>
	<AuthForm
		mode="register"
		title="Create account"
		titleKey="auth.register.heading"
		description="Complete the fields to register."
		descriptionKey="auth.register.body"
		submitLabel="Create account"
		submitLabelKey="auth.register.submit"
		links={[
			{ href: '/login', label: 'auth.register.haveAccount' },
			{ href: '/reset-password', label: 'auth.register.needRecovery' }
		]}
	/>
</AuthLayout>
