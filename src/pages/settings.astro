---
import { initSettingsPage } from '../scripts/auth-client';
import PrivateLayout from '../layouts/PrivateLayout.astro';

const sections = [
	{
		title: 'Behavior',
		description: 'Definí cómo responde la sesión: ritmo, enfoque, feedback y densidad general.',
		items: ['Quick restart', 'Confidence mode', 'Focus pause on error']
	},
	{
		title: 'Input',
		description: 'Preferencias de entrada, teclas rápidas y pequeños gestos para moverte más rápido.',
		items: ['Stop on word', 'Loose space handling', 'Command shortcuts']
	},
	{
		title: 'Sound',
		description: 'Capas de audio discretas para confirmación, error y ambiente.',
		items: ['Key hits', 'Error click', 'Ambient toggle']
	},
	{
		title: 'Caret',
		description: 'Ajustes del cursor para que se sienta más visible o más calmado.',
		items: ['Block caret', 'Smooth blink', 'Trail intensity']
	},
	{
		title: 'Appearance',
		description: 'Escala visual, contraste y densidad del layout en pantalla.',
		items: ['Font scale', 'High contrast', 'Compact stats']
	},
	{
		title: 'Theme',
		description: 'Variantes del mismo lenguaje oscuro y dorado para mantener identidad sin perder foco.',
		items: ['Terminal gold', 'Muted amber', 'Night graphite']
	},
	{
		title: 'Hide elements',
		description: 'Controlá qué bloques querés ocultar cuando solo importa escribir.',
		items: ['Hide tips', 'Hide extra metrics', 'Hide footer accents']
	},
	{
		title: 'Danger zone',
		description: 'Acciones sensibles y reversibles para la próxima etapa de producto.',
		items: ['Clear local session', 'Reset visual profile', 'Sign out everywhere']
	}
];
---

<PrivateLayout
	title="MonkeyType | Settings"
	description="Configuración privada de MonkeyType inspirada en la estructura general del producto."
	activeHref="/settings"
	pageEyebrow="Settings"
	pageTitle="Ajustá la experiencia hasta que se sienta tuya."
	pageDescription="La pantalla replica la lógica general de una configuración profunda: categorías claras, controles visuales y una zona sensible separada del resto."
>
	<section class="settings-page" data-settings-page>
		<article class="terminal-panel settings-profile">
			<div>
				<span class="eyebrow">Profile</span>
				<h2 data-settings-user-name>—</h2>
				<p data-settings-user-email>—</p>
			</div>
			<div class="settings-profile__actions">
				<button class="button-ghost" data-action="logout" type="button">Cerrar sesión</button>
			</div>
		</article>

		<div class="status-box is-visible" data-settings-status data-tone="info">Cargando preferencias...</div>

		<section class="settings-grid">
			{sections.map((section) => (
				<article class:list={["terminal-panel", "settings-card", section.title === 'Danger zone' && 'is-danger']}>
					<div class="settings-card__header">
						<h3>{section.title}</h3>
						<span>{section.items.length} opciones</span>
					</div>
					<p>{section.description}</p>
					<ul>
						{section.items.map((item) => (
							<li>
								<span>{item}</span>
								<button type="button">Placeholder</button>
							</li>
						))}
					</ul>
				</article>
			))}
		</section>
	</section>
</PrivateLayout>

<script type="module">
	initSettingsPage();
</script>

<style>
	.settings-page {
		display: grid;
		gap: 1rem;
	}

	.settings-profile {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
		padding: 1.4rem 1.6rem;
	}

	.settings-profile h2 {
		margin: 0.8rem 0 0.3rem;
		font-family: var(--font-display);
		font-size: 1.8rem;
	}

	.settings-profile p {
		margin: 0;
		color: var(--text-muted);
	}

	.settings-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.settings-card {
		padding: 1.35rem 1.4rem;
	}

	.settings-card__header {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
	}

	.settings-card__header h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
	}

	.settings-card__header span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.settings-card p {
		margin: 0.85rem 0 1rem;
		color: var(--text-muted);
	}

	.settings-card ul {
		display: grid;
		gap: 0.7rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.settings-card li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
		padding: 0.85rem 0.95rem;
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.05);
	}

	.settings-card li span {
		color: var(--text);
	}

	.settings-card li button {
		padding: 0.55rem 0.8rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		background: transparent;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.settings-card.is-danger {
		border-color: rgba(255, 143, 122, 0.25);
	}

	.settings-card.is-danger li button {
		color: var(--danger);
		border-color: rgba(255, 143, 122, 0.22);
	}

	@media (max-width: 900px) {
		.settings-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.settings-profile,
		.settings-card li,
		.settings-card__header {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
