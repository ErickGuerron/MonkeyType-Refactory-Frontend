---
import PrivateLayout from '../layouts/PrivateLayout.astro';

const modeOptions = [
	{ value: 'time', label: 'Time (configurable duration)', key: 'settings.mode.time' },
	{ value: 'quote', label: 'Quote complete', key: 'settings.mode.quote' },
	{ value: 'words', label: 'Words (50 / 100 / 150 on home)', key: 'settings.mode.words' },
	{ value: 'zen', label: 'Zen (free writing)', key: 'settings.mode.zen' },
	{ value: 'custom', label: 'Custom', key: 'settings.mode.custom' }
];

const languageOptions = [
	{ value: 'english', label: 'English', key: 'settings.language.english' },
	{ value: 'spanish', label: 'Spanish', key: 'settings.language.spanish' }
];

const timeOptions = [
	{ value: 30, label: '30 seconds', key: 'settings.time.30' },
	{ value: 60, label: '60 seconds', key: 'settings.time.60' },
	{ value: 120, label: '120 seconds', key: 'settings.time.120' }
];

const themeOptions = [
	{ value: 'system', label: 'System', key: 'settings.theme.system' },
	{ value: 'dark', label: 'Dark', key: 'settings.theme.dark' },
	{ value: 'light', label: 'Light', key: 'settings.theme.light' }
];
---

<PrivateLayout
	title="MonkeyType | Settings"
	titleKey="settings.title"
	description="Private MonkeyType settings connected to real backend preferences."
	descriptionKey="settings.descriptionMeta"
	activeHref="/settings"
	pageEyebrow="Settings"
	pageEyebrowKey="settings.pageEyebrow"
	pageTitle="Tune the experience until it feels yours."
	pageTitleKey="settings.pageTitle"
	pageDescription="The visual structure stays deep and organized, but now theme, quote language, default mode, time duration, live WPM, punctuation, numbers, and sound are read from and persisted to the real API."
	pageDescriptionKey="settings.pageDescription"
>
	<section class="settings-page" data-settings-page>
		<article class="terminal-panel settings-profile">
			<div>
				<span class="eyebrow" data-i18n="settings.profile">Profile</span>
				<h2 data-settings-user-name>—</h2>
				<p data-settings-user-email>—</p>
			</div>
			<div class="settings-profile__actions">
				<button class="button-ghost" data-action="logout" data-i18n="settings.logout" type="button">Log out</button>
			</div>
		</article>

		<div class="status-box" data-settings-status data-tone="info"></div>

		<form class="settings-grid" data-preferences-form>
			<article class="terminal-panel settings-card settings-card--form">
				<div class="settings-card__header">
					<h3 data-i18n="settings.experience">Experience</h3>
					<span data-i18n="settings.core">Core</span>
				</div>
				<p data-i18n="settings.experienceBody">The essentials so the typing home arrives ready: theme, quote language, and default mode.</p>
				<div class="settings-fields">
					<label class="settings-field settings-field--wide">
						<span data-i18n="settings.uiLanguage">UI language</span>
						<select data-ui-locale-select aria-label="UI language selector" data-i18n-aria-label="settings.uiLanguageAria">
							<option value="en" data-i18n-option="locale.en">English</option>
							<option value="es" data-i18n-option="locale.es">Spanish</option>
						</select>
						<small data-i18n="settings.uiLanguageBody">Changes the language of the whole page interface without affecting the quote language.</small>
					</label>
					<label class="settings-field">
						<span data-i18n="settings.theme">Theme</span>
						<select name="theme">
							{themeOptions.map((option) => (
								<option value={option.value} data-i18n-option={option.key}>{option.label}</option>
							))}
						</select>
					</label>
					<label class="settings-field">
						<span data-i18n="settings.quoteLanguage">Quote language</span>
						<select name="language">
							{languageOptions.map((option) => (
								<option value={option.value} data-i18n-option={option.key}>{option.label}</option>
							))}
						</select>
					</label>
					<label class="settings-field">
						<span data-i18n="settings.defaultMode">Default mode</span>
						<select name="defaultMode">
							{modeOptions.map((option) => (
								<option value={option.value} data-i18n-option={option.key}>{option.label}</option>
							))}
						</select>
					</label>
					<label class="settings-field">
						<span data-i18n="settings.timeDuration">Time duration</span>
						<select name="timeDuration">
							{timeOptions.map((option) => (
								<option value={option.value} data-i18n-option={option.key}>{option.label}</option>
							))}
						</select>
					</label>
				</div>
			</article>

			<article class="terminal-panel settings-card settings-card--form">
				<div class="settings-card__header">
					<h3 data-i18n="settings.liveFeedback">Live feedback</h3>
					<span data-i18n="settings.runtime">Runtime</span>
				</div>
				<p data-i18n="settings.liveFeedbackBody">Control how much signal appears while you type and whether you want subtle audio for error/success.</p>
				<div class="settings-toggles">
					<label class="settings-toggle">
						<div>
							<strong data-i18n="settings.showLiveWpm">Show live WPM</strong>
							<p data-i18n="settings.showLiveWpmBody">Show or hide the live metric on the main screen.</p>
						</div>
						<input name="showLiveWpm" type="checkbox" />
					</label>
					<label class="settings-toggle">
						<div>
							<strong data-i18n="settings.punctuationEnabled">Punctuation enabled</strong>
							<p data-i18n="settings.punctuationEnabledBody">In words/time it keeps punctuation; in quote it always preserves the natural text.</p>
						</div>
						<input name="punctuationEnabled" type="checkbox" />
					</label>
					<label class="settings-toggle">
						<div>
							<strong data-i18n="settings.numbersEnabled">Numbers enabled</strong>
							<p data-i18n="settings.numbersEnabledBody">In words/time it keeps numbers; when off it derives text from the original quote without digits.</p>
						</div>
						<input name="numbersEnabled" type="checkbox" />
					</label>
					<label class="settings-toggle">
						<div>
							<strong data-i18n="settings.soundEnabled">Sound enabled</strong>
							<p data-i18n="settings.soundEnabledBody">Enable subtle tones for errors and test completion.</p>
						</div>
						<input name="soundEnabled" type="checkbox" />
					</label>
				</div>
			</article>

			<article class="terminal-panel settings-card">
				<div class="settings-card__header">
					<h3 data-i18n="settings.preview">Preview</h3>
					<span data-i18n="settings.now">Now</span>
				</div>
				<p data-settings-summary>Theme system • english • time 30s • live WPM on • punctuation off • numbers off • sound off</p>
				<ul class="settings-bullets">
					<li><span data-i18n="settings.previewBullet1">Home uses quote language + default mode + time duration to choose a quote, base duration, or build words 50/100/150.</span></li>
					<li><span data-i18n="settings.previewBullet2">Words and time derive the text from the original quote applying punctuation and numbers filters.</span></li>
					<li><span data-i18n="settings.previewBullet3">Theme is applied live on the current layout.</span></li>
					<li><span data-i18n="settings.previewBullet4">Zen stores stats/results, but does not persist free text as a quote in Mongo.</span></li>
					<li><span data-i18n="settings.previewBullet5">Changes are saved with a real PATCH to /api/users/me/preferences.</span></li>
				</ul>
			</article>

			<article class="terminal-panel settings-card is-danger">
				<div class="settings-card__header">
					<h3 data-i18n="settings.dangerTitle">Danger zone</h3>
					<span data-i18n="settings.session">Session</span>
				</div>
				<p data-i18n="settings.dangerBody">We keep a sensitive zone, but without smoke: you can discard local changes or log out from the current device.</p>
				<div class="settings-actions">
					<button class="button-secondary" data-action="reset-form" data-i18n="settings.discardChanges" type="button">Discard changes</button>
					<button class="button-ghost" data-action="logout" data-i18n="settings.logout" type="button">Log out</button>
				</div>
			</article>

			<div class="settings-submit">
				<button class="button-primary" data-action="save-preferences" data-i18n="settings.savePreferences" type="submit">Save preferences</button>
			</div>
		</form>
	</section>
</PrivateLayout>

<script>
	import { initSettingsPage } from '../scripts/settings-page';

	initSettingsPage();
</script>

<style>
	.settings-page {
		display: grid;
		gap: 1rem;
	}

	.settings-profile {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
		padding: 1.4rem 1.6rem;
	}

	.settings-profile h2 {
		margin: 0.8rem 0 0.3rem;
		font-family: var(--font-display);
		font-size: 1.8rem;
	}

	.settings-profile p {
		margin: 0;
		color: var(--text-muted);
	}

	.settings-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		align-items: start;
	}

	.settings-card {
		padding: 1.35rem 1.4rem;
	}

	.settings-card--form {
		min-height: 100%;
	}

	.settings-card__header {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
	}

	.settings-card__header h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
	}

	.settings-card__header span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.settings-card p {
		margin: 0.85rem 0 1rem;
		color: var(--text-muted);
	}

	.settings-fields,
	.settings-toggles,
	.settings-actions {
		display: grid;
		gap: 0.85rem;
	}

	.settings-field {
		display: grid;
		gap: 0.45rem;
	}

	.settings-field--wide {
		grid-column: 1 / -1;
	}

	.settings-field span,
	.settings-toggle strong {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.settings-field select {
		min-height: 3rem;
		padding: 0.8rem 0.95rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--radius-sm);
		background: var(--surface-elevated);
		color: var(--text);
		appearance: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		color-scheme: inherit;
	}

	.settings-field select:focus {
		outline: none;
		border-color: color-mix(in srgb, var(--accent) 28%, transparent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 10%, transparent);
	}

	.settings-field select option {
		background: var(--surface-elevated);
		color: var(--text);
	}

	.settings-field small {
		color: var(--text-dim);
		font-size: 0.82rem;
		line-height: 1.45;
	}

	.settings-toggle {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
		padding: 0.95rem 1rem;
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.05);
	}

	.settings-toggle p {
		margin: 0.35rem 0 0;
		font-size: 0.92rem;
	}

	.settings-toggle input {
		width: 1.15rem;
		height: 1.15rem;
		accent-color: var(--accent);
	}

	.settings-bullets {
		display: grid;
		gap: 0.7rem;
		margin: 0;
		padding-left: 1rem;
		color: var(--text-muted);
	}

	.settings-bullets code {
		font-family: var(--font-mono);
		color: var(--accent-strong);
	}

	.settings-actions {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.settings-submit {
		grid-column: 1 / -1;
		display: flex;
		justify-content: flex-end;
	}

	.settings-bullets li {
		padding: 0;
		background: transparent;
		border: 0;
	}

	.settings-card.is-danger {
		border-color: rgba(255, 143, 122, 0.25);
	}

	@media (max-width: 900px) {
		.settings-grid {
			grid-template-columns: 1fr;
		}

		.settings-submit {
			justify-content: stretch;
		}

		.settings-submit button {
			width: 100%;
		}
	}

	@media (max-width: 640px) {
		.settings-profile,
		.settings-card__header,
		.settings-toggle,
		.settings-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.settings-actions {
			display: flex;
		}
	}
</style>
