---
import AuthForm from '../components/auth/AuthForm.astro';
import AuthLayout from '../ui/layouts/AuthLayout.astro';
---

<AuthLayout
	title="MonkeyType | Login"
	titleKey="auth.login.title"
	description="Sign in to MonkeyType."
	descriptionKey="auth.login.descriptionMeta"
	activeHref="/login"
>
	<AuthForm
		mode="login"
		title="Sign in"
		titleKey="auth.login.heading"
		description="Enter with your email and password."
		descriptionKey="auth.login.body"
		submitLabel="Sign in"
		submitLabelKey="auth.login.submit"
		links={[
			{ href: '/register', label: 'auth.login.createAccount' },
			{ href: '/reset-password', label: 'auth.login.forgotPassword' }
		]}
	/>
</AuthLayout>
