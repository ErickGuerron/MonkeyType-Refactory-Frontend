---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MonkeyType | Redirecting" titleKey="app.redirectTitle" description="Internal redirect to the new main private route." descriptionKey="app.redirectDescription">
	<div class="redirect-page">
		<p data-i18n="app.redirectBody">Redirecting to your new private home...</p>
	</div>

	<script>
		window.location.replace('/home');
	</script>
</Layout>

<style>
	.redirect-page {
		min-height: 100vh;
		display: grid;
		place-items: center;
		color: var(--text-muted);
		font-family: var(--font-mono);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
</style>
