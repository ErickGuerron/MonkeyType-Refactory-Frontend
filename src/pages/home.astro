---
import HomeTypingExperience from '../components/home/HomeTypingExperience.astro';
import PrivateLayout from '../ui/layouts/PrivateLayout.astro';
---

<PrivateLayout
	title="MonkeyType | Home"
	titleKey="home.title"
	description="Main typing test connected to real quotes, results, and preferences."
	descriptionKey="home.descriptionMeta"
	activeHref="/home"
	pageEyebrow="Typing"
	pageEyebrowKey="home.pageEyebrow"
	pageTitle="Writing becomes the center again."
	pageTitleKey="home.pageTitle"
	pageDescription="Your private home now starts a real quote, respects backend preferences, and stores results without breaking the current integration."
	pageDescriptionKey="home.pageDescription"
	showPageIntro={false}
	layoutWidth="typing"
>
	<HomeTypingExperience />
</PrivateLayout>

<script>
	import { initHomePage } from '../app/scripts/home-page';

	initHomePage();
</script>
