---
import HomeTypingExperience from '../components/home/HomeTypingExperience.astro';
import PrivateLayout from '../layouts/PrivateLayout.astro';
---

<PrivateLayout
	title="MonkeyType | Home"
	description="Typing test principal de MonkeyType conectado a quotes, resultados y preferencias reales."
	activeHref="/home"
	pageEyebrow="Typing"
	pageTitle="Escribir vuelve a ser el centro."
	pageDescription="Tu home privada ahora arranca una quote real, respeta preferencias del backend y guarda resultados sin romper la integración actual."
	showPageIntro={false}
	layoutWidth="typing"
>
	<HomeTypingExperience />
</PrivateLayout>

<script>
	import { initHomePage } from '../scripts/home-page';

	initHomePage();
</script>
