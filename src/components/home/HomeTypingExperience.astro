<section class="typing-page" data-typing-page>
  <div class="status-box" data-typing-status data-tone="info"></div>

  <section
    class="typing-config terminal-panel"
    aria-label="Quick configuration"
    data-i18n-aria-label="home.quickConfigAria"
  >
    <div class="typing-config__group">
      <span class="typing-config__label" data-i18n="home.mode">mode</span>
      <div class="typing-config__chips">
        <button
          class="typing-chip"
          data-pref-key="defaultMode"
          data-pref-value="time"
          data-i18n="home.time"
          type="button">time</button
        >
        <button
          class="typing-chip"
          data-pref-key="defaultMode"
          data-pref-value="quote"
          data-i18n="home.mode.quote"
          type="button">quote</button
        >
        <button
          class="typing-chip"
          data-pref-key="defaultMode"
          data-pref-value="words"
          data-i18n="home.words"
          type="button">words</button
        >
        <button
          class="typing-chip"
          data-pref-key="defaultMode"
          data-pref-value="zen"
          data-i18n="home.mode.zen"
          type="button">zen</button
        >
      </div>
    </div>

    <div class="typing-config__group">
      <span class="typing-config__label" data-i18n="home.quoteLanguage">quote language</span>
      <label class="typing-config__select-shell">
        <select class="typing-config__select" data-pref-select="language" aria-label="Select quote language" data-i18n-aria-label="home.selectQuoteLanguageAria">
          <option value="english" data-i18n-option="settings.language.english">english</option>
          <option value="spanish" data-i18n-option="settings.language.spanish">spanish</option>
        </select>
      </label>
    </div>

    <div class="typing-config__group is-utility">
      <span class="typing-config__label" data-i18n="home.signals">signals</span>
      <div class="typing-config__chips">
        <button
          class="typing-chip"
          data-pref-key="showLiveWpm"
          data-pref-toggle="true"
          data-i18n="home.liveWpm"
          type="button">live wpm</button
        >
        <button
          class="typing-chip"
          data-pref-key="punctuationEnabled"
          data-pref-toggle="true"
          data-i18n="home.punctuation"
          type="button">punctuation</button
        >
        <button
          class="typing-chip"
          data-pref-key="numbersEnabled"
          data-pref-toggle="true"
          data-i18n="home.numbers"
          type="button">numbers</button
        >
        <button
          class="typing-chip"
          data-pref-key="soundEnabled"
          data-pref-toggle="true"
          data-i18n="home.sound"
          type="button">sound</button
        >
        <label class="typing-config__select-shell typing-config__select-shell--chip typing-config__select-shell--signal" data-mode-control="time">
          <select class="typing-config__select typing-config__select--chip" data-pref-select="timeMode" aria-label="Select time mode" data-i18n-aria-label="home.selectTimeModeAria">
            <option value="30">30</option>
            <option value="60">60</option>
            <option value="120">120</option>
          </select>
        </label>
        <label class="typing-config__select-shell typing-config__select-shell--chip typing-config__select-shell--signal" data-mode-control="words">
          <select class="typing-config__select typing-config__select--chip" data-pref-select="wordsMode" aria-label="Select words mode" data-i18n-aria-label="home.selectWordsModeAria">
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="150">150</option>
          </select>
        </label>
      </div>
    </div>
  </section>

  <section class="typing-stage" aria-label="Main typing test" data-i18n-aria-label="home.typingStageAria">
    <header class="typing-stage__hud">
      <div>
        <p class="typing-stage__timer-label" data-i18n="home.time">time</p>
        <strong class="typing-stage__timer" data-stat="timer">30s</strong>
      </div>

      <div class="typing-stage__summary">
        <span class="typing-inline-stat" data-current-mode>time 30s</span>
        <span class="typing-inline-stat" data-current-language>english</span>
        <span class="typing-inline-stat" data-live-wpm-card>
          <span data-i18n="home.live">live</span>
          <strong data-stat="wpm">0</strong>
        </span>
      </div>
    </header>

    <div class="typing-stage__center">
      <p class="typing-stage__source mono" data-quote-source>
        Quote backend • English
      </p>
      <label
        class="typing-stage__surface"
        data-quote-surface
        aria-label="Main typing input"
        data-i18n-aria-label="home.typingSurfaceAria"
      >
        <div class="typing-stage__panning" data-typing-panning>
          <div
            class="typing-stage__quote"
            data-action="focus-input"
            data-quote-text
          >
          </div>
          <textarea
            class="typing-stage__overlay-input"
            data-typing-input
            spellcheck="false"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            placeholder=""></textarea>
          <div class="typing-stage__caret" data-typing-caret></div>
        </div>
      </label>
    </div>

    <div class="typing-stage__input-shell" aria-label="Typing helper" data-i18n-aria-label="home.typingHelpAria">
      <span class="typing-stage__input-hint mono" data-typing-hint
        data-i18n="home.typingHint"
        >type directly over the quote and keep your focus in the line</span
      >
    </div>

    <footer class="typing-stage__footer">
      <div class="typing-stage__stats">
        <div class="typing-stage__stat">
          <span data-i18n="home.raw">raw</span>
          <strong data-stat="raw">0</strong>
        </div>
        <div class="typing-stage__stat">
          <span data-i18n="home.acc">acc</span>
          <strong data-stat="accuracy">100%</strong>
        </div>
      </div>

      <div class="typing-stage__actions">
        <button class="typing-action" data-action="restart" data-i18n="home.restart" type="button"
          >restart</button
        >
        <button class="typing-action" data-action="next-quote" data-i18n="home.next" type="button"
          >next</button
        >
        <button class="typing-action" data-action="focus-input" data-i18n="home.focus" type="button"
          >focus</button
        >
        <button class="typing-action" data-action="finish-zen" data-i18n="home.finishZen" type="button" hidden
          >finish zen</button
        >
      </div>
    </footer>

    <section class="typing-result-modal" data-result-card hidden>
      <div class="typing-result-modal__backdrop" data-action="close-result"></div>
      <div class="typing-result terminal-panel" role="dialog" aria-modal="true" aria-labelledby="typing-result-title">
        <div class="typing-result__header">
          <div>
            <p class="typing-result__eyebrow" data-i18n="home.resultEyebrow">test completed</p>
            <h2 id="typing-result-title" data-result-title>Result saved</h2>
          </div>
          <p data-result-summary></p>
        </div>

        <div class="typing-result__body">
          <aside class="typing-result__hero-metrics">
            <article class="typing-result__hero-block">
              <span data-i18n="home.wpm">wpm</span>
              <strong data-result-metric="wpm">0</strong>
            </article>
            <article class="typing-result__hero-block">
              <span data-i18n="home.acc">acc</span>
              <strong data-result-metric="accuracy">100%</strong>
            </article>
          </aside>

          <div class="typing-result__graph-shell">
            <div class="typing-result__graph-head">
              <span data-i18n="home.runGraph">run graph</span>
              <strong data-result-chart-value>100%</strong>
            </div>
            <div class="typing-result__graph" data-result-chart-shell>
              <canvas data-result-chart aria-label="Result chart" data-i18n-aria-label="home.resultChartAria"></canvas>
            </div>
            <div class="typing-result__legend">
              <span><i class="is-wpm"></i><span data-i18n="home.wpm">wpm</span></span>
              <span><i class="is-raw"></i><span data-i18n="home.raw">raw</span></span>
              <span><i class="is-burst"></i><span data-i18n="home.burst">burst</span></span>
              <span><i class="is-errors"></i><span data-i18n="home.errors">errors</span></span>
            </div>
          </div>
        </div>

        <div class="typing-result__summary-grid">
          <article class="typing-result__summary-item">
            <span data-i18n="home.raw">raw</span>
            <strong data-result-metric="raw">0</strong>
          </article>
          <article class="typing-result__summary-item">
            <span data-i18n="home.time">time</span>
            <strong data-result-metric="time">30s</strong>
          </article>
          <article class="typing-result__summary-item">
            <span data-i18n="home.mode">mode</span>
            <strong data-result-meta="mode">time 30</strong>
          </article>
          <article class="typing-result__summary-item">
            <span data-i18n="home.language">language</span>
            <strong data-result-meta="language">english</strong>
          </article>
        </div>

        <div class="typing-result__actions">
          <button class="button-secondary" data-action="close-result" data-i18n="home.close" type="button">close</button>
          <button class="button-primary" data-action="next-quote" data-i18n="home.nextTest" type="button">next test</button>
        </div>
      </div>
    </section>
  </section>

  <section class="typing-rail">
    <article class="typing-rail__card terminal-panel">
      <div class="typing-rail__header">
        <div>
          <p class="typing-rail__eyebrow" data-i18n="home.profile">profile</p>
          <h3 data-home-user-name>—</h3>
          <p data-home-user-email>—</p>
        </div>
        <button class="typing-action" data-action="logout" data-i18n="home.logout" type="button"
          >logout</button
        >
      </div>
      <p class="typing-rail__copy" data-i18n="home.railCopy">The home puts writing back at the center while keeping quotes, results, and preferences connected to the current backend.</p>
    </article>

    <article class="typing-rail__card terminal-panel">
      <div class="typing-rail__header is-compact">
        <div>
          <p class="typing-rail__eyebrow" data-i18n="home.recentResults">recent results</p>
          <h3 data-i18n="home.history">history</h3>
        </div>
        <a class="typing-inline-link" href="/settings" data-i18n="home.preferences">preferences</a>
      </div>
      <ul class="typing-history" data-history-list></ul>
    </article>
  </section>

  <footer class="typing-shortcuts" aria-label="Visual shortcuts" data-i18n-aria-label="home.shortcutsAria">
    <span><kbd>esc</kbd> <span data-i18n="home.shortcutRestart">restart</span></span>
    <span><kbd>tab</kbd> <span data-i18n="home.shortcutFocus">focus input</span></span>
    <span><kbd>enter</kbd> <span data-i18n="home.shortcutNext">next test after result</span></span>
    <span><kbd>ctrl</kbd> + <kbd>enter</kbd> <span data-i18n="home.shortcutFinishZen">finish zen</span></span>
  </footer>
</section>

<style>
  .typing-page {
    display: grid;
    gap: 1.2rem;
  }

  .typing-config {
    display: grid;
    grid-template-columns: repeat(3, minmax(15rem, 1fr));
    gap: 0.85rem;
    padding: 0.7rem 0.9rem;
    border-radius: 18px;
    align-items: start;
  }

  .typing-config__group {
    display: grid;
    gap: 0.55rem;
  }

 	.typing-config__group.is-utility {
		justify-self: stretch;
	}

  .typing-config__label,
  .typing-config__micro-label,
  .typing-result__eyebrow,
  .typing-rail__eyebrow,
  .typing-stage__timer-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

	.typing-config__micro-label {
		display: inline-flex;
		align-items: center;
		padding-inline: 0.15rem;
	}

	.typing-config__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: stretch;
	}

	.typing-config__select-shell {
		position: relative;
		display: block;
	}

	.typing-config__select-shell--chip {
		flex: 1 1 7.25rem;
		min-width: 0;
		max-width: 10rem;
	}

	.typing-config__select-shell--signal {
		flex: 1 1 8rem;
	}

	.typing-config__select-shell--signal[hidden] {
		display: none !important;
	}

	.typing-config__select-shell::after {
		content: '⌄';
		position: absolute;
		right: 0.7rem;
		top: 50%;
		transform: translateY(-52%);
		pointer-events: none;
		color: var(--text-dim);
		font-size: 0.8rem;
	}

	.typing-config__select {
		width: 100%;
		min-height: 1.95rem;
		padding: 0.3rem 2rem 0.3rem 0.7rem;
		border: 0;
		border-radius: 12px;
		background: var(--surface-elevated);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: lowercase;
		appearance: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		color-scheme: inherit;
	}

	.typing-config__select--chip {
		min-width: 0;
		width: 100%;
		background: color-mix(in srgb, var(--text) 3%, transparent);
		color: var(--text-dim);
	}

	.typing-config__select--chip:focus,
	.typing-config__select--chip:hover {
		color: var(--accent);
		background: color-mix(in srgb, var(--text) 5%, transparent);
	}

	.typing-config__select:focus {
		outline: none;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 24%, transparent);
	}

	.typing-config__select option {
		background: var(--surface-elevated);
		color: var(--text);
	}

  .typing-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 1 auto;
    min-height: 1.7rem;
    padding: 0.28rem 0.62rem;
    max-width: 100%;
    border: 0;
    border-radius: 12px;
    background: color-mix(in srgb, var(--text) 3%, transparent);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    transition:
      color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

	.typing-chip[hidden],
	.typing-action[hidden] {
		display: none !important;
	}

  .typing-chip:hover,
  .typing-chip.is-active,
  .typing-chip--link:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }

  .typing-chip.is-active {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .typing-stage {
    position: relative;
    display: grid;
    gap: 1rem;
    min-height: clamp(32rem, 72vh, 44rem);
    padding: clamp(1.1rem, 2.5vw, 1.6rem) clamp(0.85rem, 3vw, 2rem);
  }

  .typing-stage__footer,
  .typing-result__header,
  .typing-result__actions,
  .typing-rail__header,
  .typing-history li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

	.typing-stage__hud {
		display: grid;
		grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
		align-items: start;
		gap: 0.75rem 1rem;
	}

  .typing-stage__timer {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.9;
    color: var(--accent);
  }

  .typing-stage__summary {
		display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    justify-self: end;
    align-self: start;
    gap: 0.45rem;
  }

  .typing-inline-stat,
  .typing-inline-link,
  .typing-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    flex: 0 0 auto;
    gap: 0.32rem;
    padding: 0.3rem 0.62rem;
    min-height: 1.7rem;
    min-width: fit-content;
    border-radius: 14px;
    border: 0;
    background: color-mix(in srgb, var(--text) 4%, transparent);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    white-space: nowrap;
		max-width: 100%;
  }

	.typing-inline-stat {
		min-height: 2.1rem;
		padding: 0.42rem 0.8rem;
		border: 1px solid color-mix(in srgb, var(--accent) 14%, transparent);
		border-radius: 16px;
		background: color-mix(in srgb, var(--text) 3%, transparent);
		color: var(--text-dim);
		box-shadow: inset 0 1px 0 color-mix(in srgb, white 4%, transparent);
	}

  .typing-inline-stat strong {
    font-size: 0.82rem;
    color: var(--accent);
  }

  .typing-action,
  .typing-inline-link {
    transition:
      color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .typing-action:hover,
  .typing-inline-link:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--text) 7%, transparent);
    transform: translateY(-1px);
  }

  .typing-stage__center {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.7rem;
    min-height: 15rem;
    padding: 0.5rem 0;
  }

  .typing-stage__source {
    margin: 0;
    width: min(100%, 72ch);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-align: left;
  }

  .typing-stage__panning {
    position: relative;
    width: 100%;
    transition: transform 120ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }

	.typing-page[data-quote-switching='true'] .typing-stage__panning {
		transition: none;
	}

  .typing-stage__caret {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    background: var(--accent);
    border-radius: 4px;
    transition: transform 120ms cubic-bezier(0.25, 0.8, 0.25, 1);
    z-index: 3;
    pointer-events: none;
    animation: caret-blink 1.2s infinite;
    /* Default height, overridden by JS if character height available */
    height: clamp(1.4rem, 2.5vw, 1.8rem);
  }

	.typing-page[data-quote-switching='true'] .typing-stage__caret {
		transition: none;
		animation: none;
	}

  @keyframes caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .typing-stage__quote {
    position: relative;
    z-index: 1;
    width: 100%;
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--text) 32%, transparent);
    white-space: pre-wrap;
    text-align: left;
    overflow-wrap: break-word;
  }

  .typing-stage__surface {
    position: relative;
    display: block;
    width: min(100%, 72ch);
    margin: 0 auto;
    overflow: hidden;
    cursor: text;
    border-radius: 4px;
  }

  :global(.typing-char) {
    border-radius: 0.2rem;
    transition:
      color 120ms ease,
      background-color 120ms ease;
    white-space: pre-wrap;
  }

  :global(.typing-char.is-pending) {
    color: color-mix(in srgb, var(--text) 30%, transparent);
  }

  :global(.typing-char.is-correct) {
    color: var(--text);
  }

  :global(.typing-char.is-wrong) {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 16%, transparent);
  }

  :global(.typing-char.is-current) {
    color: var(--accent-strong);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .typing-stage__input-shell {
    display: grid;
    gap: 0.35rem;
  }

  .typing-stage__input-hint {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .typing-stage__overlay-input {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    caret-color: transparent;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.7;
    letter-spacing: -0.02em;
    resize: none;
    overflow: hidden;
    white-space: pre-wrap;
    overflow-wrap: break-word;
    text-align: left;
    scrollbar-width: none;
  }

  .typing-stage__overlay-input::-webkit-scrollbar {
    display: none;
  }

  .typing-stage__overlay-input:focus {
    outline: none;
  }

  .typing-stage__stats {
    display: flex;
    gap: 0.75rem;
  }

  .typing-stage__stat,
  .typing-result__hero-block,
  .typing-result__summary-item {
    display: grid;
    gap: 0.25rem;
  }

  .typing-stage__stat span,
  .typing-result__hero-block span,
  .typing-result__summary-item span,
  .typing-result__chart-core span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .typing-stage__stat strong {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    color: var(--text);
  }

  .typing-stage__actions,
  .typing-result__actions {
    align-items: center;
    gap: 0.45rem;
  }

  .typing-result {
    position: relative;
    z-index: 1;
    width: min(94vw, 72rem);
    padding: 1.5rem 1.6rem;
    border-radius: 28px;
