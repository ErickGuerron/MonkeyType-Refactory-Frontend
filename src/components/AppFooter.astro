---
import { API_BASE_URL } from '../infrastructure/api/auth-api';

interface Props {
	mode?: 'public' | 'private';
}

const docsUrl = `${API_BASE_URL}/docs`;
const healthUrl = `${API_BASE_URL}/health`;
const { mode = 'public' } = Astro.props;
---

<footer class:list={['app-footer', mode === 'private' && 'is-private']}>
	<div class="container app-footer__inner">
		<div>
			<p class="app-footer__title">MonkeyType</p>
			<p class="app-footer__copy" data-i18n={mode === 'private' ? 'footer.privateCopy' : 'footer.publicCopy'}>
				{mode === 'private'
					? 'Typing minimalista en Astro, conectado a quotes, resultados y preferencias reales.'
					: 'Una experiencia oscura, sobria y lista para entrar, practicar y ajustar tu espacio de escritura.'}
			</p>
		</div>

		<div class="app-footer__links mono">
			{mode === 'private' && <a href="/settings" data-i18n="footer.settings">Settings</a>}
			<a href={docsUrl} target="_blank" rel="noreferrer" data-i18n="footer.apiDocs">API docs</a>
			<a href={healthUrl} target="_blank" rel="noreferrer" data-i18n="footer.health">Health</a>
		</div>
	</div>
</footer>

<style>
	.app-footer {
		padding: 1rem 0 1.6rem;
	}

	.app-footer.is-private {
		padding-top: 0.25rem;
	}

	.app-footer__inner {
		display: flex;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.app-footer__title {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.app-footer__copy {
		margin: 0.4rem 0 0;
		max-width: 38rem;
		color: var(--text-dim);
		font-size: 0.92rem;
	}

	.app-footer__links {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: flex-end;
		gap: 0.9rem;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.app-footer__links a {
		color: var(--text-muted);
	}

	.app-footer__links a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.app-footer__inner {
			flex-direction: column;
		}

		.app-footer__links {
			justify-content: flex-start;
		}
	}
</style>
