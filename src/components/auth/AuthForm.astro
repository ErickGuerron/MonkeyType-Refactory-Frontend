---
type Mode = 'login' | 'register' | 'reset' | 'reset-confirm';

interface LinkItem {
	href: string;
	label: string;
}

interface Props {
	mode: Mode;
	title: string;
	titleKey?: string;
	description: string;
	descriptionKey?: string;
	submitLabel: string;
	submitLabelKey?: string;
	links?: LinkItem[];
	note?: string;
	noteKey?: string;
}

const { mode, title, titleKey, description, descriptionKey, submitLabel, submitLabelKey, links = [], note, noteKey } = Astro.props;

const formId = `auth-form-${mode}`;
---

<article class="auth-form terminal-panel">
	<div class="auth-form__header">
		<h1 data-i18n={titleKey}>{title}</h1>
		<p data-i18n={descriptionKey}>{description}</p>
	</div>

	{note && <p class="auth-form__note" data-i18n={noteKey}>{note}</p>}

	<form class="auth-form__body" data-auth-form data-mode={mode} id={formId} novalidate>
		{mode === 'register' && (
			<label class="field">
				<span data-i18n="auth.fieldName">Name</span>
				<input autocomplete="name" name="name" placeholder="Ada Lovelace" required type="text" />
			</label>
		)}

		{mode !== 'reset-confirm' && (
			<label class="field">
				<span data-i18n="auth.fieldEmail">Email</span>
				<input autocomplete="email" name="email" placeholder="name@monkeytype.dev" data-i18n-placeholder="auth.form.placeholderEmail" required type="email" />
			</label>
		)}

		{mode !== 'reset' && (
			<label class="field">
				<span data-i18n="auth.fieldPassword">Password</span>
				<input autocomplete={mode === 'login' ? 'current-password' : 'new-password'} name="password" placeholder="••••••••" required type="password" />
			</label>
		)}

		{(mode === 'register' || mode === 'reset-confirm') && (
			<label class="field">
				<span data-i18n="auth.fieldConfirmPassword">Confirm password</span>
				<input autocomplete="new-password" name="confirmPassword" placeholder="••••••••" required type="password" />
			</label>
		)}

		<button class="button-primary auth-form__submit" data-i18n={submitLabelKey} type="submit">{submitLabel}</button>
	</form>

	{links.length > 0 && (
		<div class="auth-form__links">
			{links.map((link) => (
				<a href={link.href} data-i18n={link.label}>{link.label}</a>
			))}
		</div>
	)}
</article>

<script>
	import { initAuthForms } from '../../scripts/auth-client';

	initAuthForms();
</script>

<style>
	.auth-form {
		width: 100%;
		padding: 1.5rem;
	}

	.auth-form__header h1 {
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4vw, 2.5rem);
		line-height: 1;
	}

	.auth-form__header p,
	.auth-form__note {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.auth-form__note {
		margin-top: 1rem;
		padding: 0.75rem 0.9rem;
		border-left: 1px solid var(--border-strong);
		background: rgba(255, 255, 255, 0.02);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
	}

	.auth-form__body {
		display: grid;
		gap: 1rem;
		margin-top: 1.15rem;
	}

	.field {
		display: grid;
		gap: 0.55rem;
	}

	.field span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.field input {
		width: 100%;
		padding: 0.9rem 0.15rem;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		background: transparent;
		color: var(--text);
		outline: none;
		transition: border-color 160ms ease, box-shadow 160ms ease;
	}

	.field input::placeholder {
		color: rgba(247, 241, 221, 0.28);
	}

	.field input:focus {
		border-bottom-color: var(--accent);
		box-shadow: inset 0 -1px 0 var(--accent);
	}

	.auth-form__submit {
		margin-top: 0.5rem;
		width: 100%;
	}

	.auth-form__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1rem;
		margin-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.auth-form__links a {
		color: var(--text-muted);
	}

	.auth-form__links a:hover {
		color: var(--accent);
	}
</style>
