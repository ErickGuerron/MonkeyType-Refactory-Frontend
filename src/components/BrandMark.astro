---
interface Props {
	compact?: boolean;
	minimal?: boolean;
}

const { compact = false, minimal = false } = Astro.props;
---

<a class:list={["brand-mark", compact && 'is-compact']} href="/">
	<span class="brand-mark__glyph">mt</span>
	<span class="brand-mark__copy">
		<strong>MonkeyType</strong>
		{!minimal && <small data-i18n="brand.tagline">focused typing flow</small>}
	</span>
</a>

<style>
	.brand-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--text);
	}

	.brand-mark__glyph {
		display: grid;
		place-items: center;
		min-width: 2.3rem;
		height: 2.3rem;
		padding: 0 0.55rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.03);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: lowercase;
	}

	.brand-mark__copy {
		display: flex;
		flex-direction: column;
		gap: 0.08rem;
	}

	.brand-mark__copy strong {
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-weight: 600;
		letter-spacing: 0;
	}

	.brand-mark__copy small {
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.brand-mark.is-compact .brand-mark__copy small {
		display: none;
	}

	@media (max-width: 640px) {
		.brand-mark__copy small {
			display: none;
		}
	}
</style>
