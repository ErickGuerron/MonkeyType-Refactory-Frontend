---
const { compact = false } = Astro.props;
---

<a class:list={["brand-mark", compact && 'is-compact']} href="/">
	<span class="brand-mark__glyph">&gt;_</span>
	<span class="brand-mark__copy">
		<strong>MonkeyType</strong>
		<small>MONO_KINETIC typing flow</small>
	</span>
</a>

<style>
	.brand-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--text);
	}

	.brand-mark__glyph {
		display: grid;
		place-items: center;
		min-width: 3rem;
		height: 3rem;
		padding: 0 0.8rem;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: rgba(224, 193, 109, 0.06);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.95rem;
		letter-spacing: 0.12em;
	}

	.brand-mark__copy {
		display: flex;
		flex-direction: column;
		gap: 0.08rem;
	}

	.brand-mark__copy strong {
		font-family: var(--font-display);
		font-size: 1rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.brand-mark__copy small {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.brand-mark.is-compact .brand-mark__copy small {
		display: none;
	}

	@media (max-width: 640px) {
		.brand-mark__copy small {
			display: none;
		}
	}
</style>
