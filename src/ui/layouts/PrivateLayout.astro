---
import AppFooter from '../../components/AppFooter.astro';
import AppNavbar from '../components/navigation/AppNavbar.astro';
import Layout from './Layout.astro';

interface Props {
	title: string;
	description: string;
	titleKey?: string;
	descriptionKey?: string;
	activeHref?: string;
	pageEyebrow?: string;
	pageEyebrowKey?: string;
	pageTitle: string;
	pageTitleKey?: string;
	pageDescription: string;
	pageDescriptionKey?: string;
	showPageIntro?: boolean;
	layoutWidth?: 'default' | 'typing';
}

const {
	title,
	description,
	titleKey,
	descriptionKey,
	activeHref = '/home',
	pageEyebrow = 'Private area',
	pageEyebrowKey = 'layout.privateArea',
	pageTitle,
	pageTitleKey,
	pageDescription,
	pageDescriptionKey,
	showPageIntro = true,
	layoutWidth = 'default'
} = Astro.props;

const hasPageIntroAside = Astro.slots.has('pageIntroAside');
---

<Layout title={title} description={description} titleKey={titleKey} descriptionKey={descriptionKey} bodyClass="theme-private">
	<div class="page-shell">
		<AppNavbar mode="private" activeHref={activeHref} />

		<main class:list={['private-layout', layoutWidth === 'typing' ? 'private-layout--typing' : '', layoutWidth === 'typing' ? 'container-wide' : 'container']}>
			{showPageIntro && (
				<section class:list={['private-layout__hero', 'terminal-panel', hasPageIntroAside ? 'private-layout__hero--with-aside' : '']}>
					<div class="private-layout__hero-main">
						<span class="eyebrow" data-i18n={pageEyebrowKey}>{pageEyebrow}</span>
						<h1 data-i18n={pageTitleKey}>{pageTitle}</h1>
						<p data-i18n={pageDescriptionKey}>{pageDescription}</p>
					</div>
					{hasPageIntroAside && (
						<div class="private-layout__hero-aside">
							<slot name="pageIntroAside" />
						</div>
					)}
				</section>
			)}

			<slot />
		</main>

		<AppFooter mode="private" />
	</div>
</Layout>

<style>
	.private-layout {
		display: grid;
		gap: 1rem;
		flex: 1;
		padding: 1.35rem 0 2rem;
	}

	.private-layout--typing {
		gap: 1.2rem;
	}

	.private-layout__hero {
		padding: 1.5rem 1.6rem;
		border-radius: 24px;
	}

	.private-layout__hero--with-aside {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(20rem, 1.05fr);
		gap: 2rem;
		align-items: center;
	}

	.private-layout__hero-main {
		min-width: 0;
	}

	.private-layout__hero-aside {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		min-height: 100%;
	}

	.private-layout__hero h1 {
		margin: 1rem 0 0.8rem;
		max-width: 12ch;
		font-family: var(--font-display);
		font-size: clamp(2.8rem, 6vw, 4.8rem);
		line-height: 0.95;
	}

	.private-layout__hero p {
		margin: 0;
		max-width: 32rem;
		color: var(--text-muted);
	}

	@media (max-width: 900px) {
		.private-layout__hero--with-aside {
			grid-template-columns: 1fr;
		}

		.private-layout__hero-aside {
			justify-content: flex-start;
		}
	}
</style>
